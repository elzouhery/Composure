# A .env whose values carry inline comments.
#
# Permanent regression file. Before story 1.3, ParseDotEnv took the whole line
# after `=`, so SERVERURL resolved to the URL FOLLOWED BY A SENTENCE about
# duckdns, and that sentence was handed to the container as an environment
# variable. No unit test had thought to write a comment on a value; the
# differential harness against `docker compose config` found it on the first
# full corpus run (cmd/differential).
VPN_SERVER_URL=your-domain.dyndns.com # free examples http://www.duckdns.org/ and https://www.noip.com/
QUOTED_WITH_HASH="a value # with a hash in it"
# No space before the hash, so the hash is part of the value: a real line from
# a pihole compose project, naming a DNS server on a non-standard port.
UPSTREAM_DNS=1.1.1.1#5054
